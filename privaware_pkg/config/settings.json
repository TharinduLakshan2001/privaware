{
  "project": {
    "name": "PrivAware",
    "version": "1.0.0",
    "description": "Linux privacy and security auditing and monitoring tool"
  },
  "logging": {
    "level": "INFO",
    "log_file": "privaware.log"
  },
  "modules": {
    "audit": true,
    "alerts": true,
    "filewatch": true,
    "log_monitor": true,
    "servicecheck": true,
    "monitor": true,
    "remote_control": false
  },
  "audit": {
    "checks": [
      "world_readable_secrets",
      "weak_ssh_ciphers",
      "dns_leaks",
      "missing_firewall_rules",
      "integrity_checks",
      "sudoers_surprises",
      "cron_at_jobs",
      "sysctl_hardening",
      "user_accounts",
      "password_policy",
      "ssh_hardening",
      "pam_misconfigurations",
      "dns_consistency",
      "open_ports_services",
      "service_versions",
      "unencrypted_services",
      "ntp_chrony"
    ]
  },
  "alerts": {
    "rules": [
      "failed_login_attempts",
      "successful_login",
      "root_access",
      "file_permission_changes",
      "service_failures"
    ],
    "email": {
      "from": "",
      "to": ""
    }
  },
  "filewatch": {
    "paths": [
      "/etc/passwd",
      "/etc/shadow",
      "~/.ssh/authorized_keys"
    ]
  },
  "log_monitor": {
    "log_files": [
      "/var/log/auth.log",
      "/var/log/syslog"
    ],
    "suspicious_activity": [
      "failed_logins",
      "brute_force_attempts",
      "sudo_abuse"
    ]
  },
  "servicecheck": {
    "services": [
      "sshd",
      "dnsmasq",
      "nginx"
    ]
  },
  "monitor": {
    "cpu_threshold": 90,
    "memory_threshold": 90,
    "disk_threshold": 90
  },
  "remote_control": {
    "enabled": false,
    "accepted_senders": []
  }
}
